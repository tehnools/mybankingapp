{
  "expo": {
    "name": "NZ Money Manager",
    "slug": "nz-money-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nzmoney.manager",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow NZ Money Manager to use Face ID to protect your financial data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a365d"
      },
      "package": "com.nzmoney.manager",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "nz-money-manager",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NZ Money Manager to use Face ID to protect your financial data."
        }
      ]
    ]
  }
}
